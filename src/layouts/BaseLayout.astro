---
import { siteConfig } from "../config/site";
import { DEFAULT_CONTENT_IMAGE, withBasePath } from "../lib/site";
import MotionEffects from "../components/MotionEffects.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  publishedTime?: string;
  updatedTime?: string;
}

const {
  title = siteConfig.title,
  description = siteConfig.description,
  image = DEFAULT_CONTENT_IMAGE,
  type = "website",
  noindex = false,
  publishedTime,
  updatedTime,
} = Astro.props;

const basePath = import.meta.env.BASE_URL ?? "/";
const siteOrigin = Astro.site?.toString() ?? siteConfig.siteUrl;
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
const pageTitle = title === siteConfig.title ? title : `${title} | ${siteConfig.title}`;
const imageUrl = image.startsWith("http")
  ? image
  : new URL(withBasePath(image, basePath), siteOrigin).toString();
---

<!doctype html>
<html lang="zh-CN" data-base-path={basePath}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e7c66" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {updatedTime && <meta property="article:modified_time" content={updatedTime} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBasePath("/favicon.svg", basePath)} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.title} RSS`} href={withBasePath("/rss.xml", basePath)} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        try { document.documentElement.lang = localStorage.getItem("stack-edge-language") === "en" ? "en" : "zh-CN"; } catch {}
        const storageKey = "stack-edge-theme";
        const stored = localStorage.getItem(storageKey);
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = stored ?? systemTheme;
      })();
    </script>
  </head>
  <body>
    <SiteHeader currentPath={Astro.url.pathname} />
    <main class="site-shell" data-pagefind-body>
      <slot />
    </main>
    <SiteFooter />
    <MotionEffects />
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token":"fd4a602d71374e31a83844940548a085"}'
    ></script>
  </body>
</html>
