---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBasePath } from "../lib/site";

const basePath = import.meta.env.BASE_URL ?? "/";
const pagefindBundlePath = withBasePath("/pagefind/", basePath);
const pagefindScriptPath = withBasePath("/pagefind/pagefind-ui.js", basePath);
---

<BaseLayout title="搜索" description="搜索文章和项目内容。">
  <section class="search-shell">
    <div class="search-card">
      <h1 class="page-title">搜索</h1>
      <p class="page-intro">输入关键词，查找文章和项目。</p>
      <div id="search"></div>
      <p class="search-status" data-search-status>正在加载搜索…</p>
    </div>
  </section>

  <link rel="stylesheet" href={withBasePath("/pagefind/pagefind-ui.css", basePath)} />
  <script is:inline define:vars={{ basePath, pagefindBundlePath, pagefindScriptPath }}>
    const initPagefind = () => {
      const status = document.querySelector("[data-search-status]");

      if (!window.PagefindUI) {
        if (status) {
          status.textContent = "搜索暂时无法加载，请刷新页面重试。";
        }
        return;
      }

      new window.PagefindUI({
        element: "#search",
        showImages: false,
        showSubResults: true,
        resetStyles: true,
        pageSize: 6,
        excerptLength: 20,
        baseUrl: basePath,
        bundlePath: pagefindBundlePath,
        translations: {
          placeholder: "搜索文章、项目、标签",
          search_label: "搜索站点内容",
          clear_search: "清空",
          zero_results: "没有找到 [SEARCH_TERM] 的结果",
          one_result: "找到 [COUNT] 条结果： [SEARCH_TERM]",
          many_results: "找到 [COUNT] 条结果： [SEARCH_TERM]",
          load_more: "加载更多",
          searching: "正在搜索 [SEARCH_TERM]",
        },
      });

      status?.remove();
    };

    window.addEventListener("load", () => {
      if (window.PagefindUI) {
        initPagefind();
        return;
      }

      const script = document.createElement("script");
      script.src = pagefindScriptPath;
      script.onload = initPagefind;
      script.onerror = initPagefind;
      document.body.appendChild(script);
    });
  </script>
</BaseLayout>
