{
  "name": "blog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist --root-selector main",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run --pool threads",
