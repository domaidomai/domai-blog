---
import { withBasePath } from "../lib/site";

interface Props {
  tags: string[];
  linked?: boolean;
}

const { tags, linked = true } = Astro.props;
const basePath = import.meta.env.BASE_URL ?? "/";
---

<div class="tag-row">
  {tags.map((tag) =>
    linked ? (
      <a class="chip-link" href={withBasePath(`/tags/${encodeURIComponent(tag)}/`, basePath)}>
        #{tag}
      </a>
    ) : (
      <span class="chip-static">#{tag}</span>
    ),
  )}
</div>
