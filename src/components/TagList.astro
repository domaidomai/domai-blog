---
import { withBasePath } from "../lib/site";

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
const basePath = import.meta.env.BASE_URL ?? "/";
---

<div class="tag-row">
  {tags.map((tag) => (
    <a class="chip-link" href={withBasePath(`/tags/${encodeURIComponent(tag)}/`, basePath)}>
      #{tag}
    </a>
  ))}
</div>
