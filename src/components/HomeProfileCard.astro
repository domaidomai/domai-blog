---
import { siteConfig } from "../config/site";
import { resolveContentImage } from "../lib/site";
import type { HomeProfileStat } from "../lib/home";

interface Props {
  stats: HomeProfileStat[];
  basePath?: string;
}

const { stats, basePath = "/" } = Astro.props;
const bannerImage = resolveContentImage(siteConfig.profile.bannerImage, basePath);
const avatarImage = resolveContentImage(siteConfig.profile.avatarImage, basePath);
---

<article class="panel profile-panel">
  <div class="profile-banner">
    <img class="profile-banner-image" src={bannerImage} alt="" loading="eager" decoding="async" />
    <div class="profile-avatar-shell">
      <img
        class="profile-avatar"
        src={avatarImage}
        alt={`${siteConfig.profile.name} avatar`}
        loading="eager"
        decoding="async"
      />
    </div>
  </div>

  <div class="profile-body">
    <div class="profile-copy">
      <p class="profile-role">{siteConfig.profile.role}</p>
      <h2 class="profile-name">{siteConfig.profile.name}</h2>
      <p class="profile-headline">{siteConfig.profile.headline}</p>
      <p class="profile-summary">{siteConfig.profile.summary}</p>
    </div>

    <div class="profile-stat-row">
      {stats.map((stat) => (
        <div class="profile-stat-item">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</article>
