    "generate-types": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/cloudflare": "^13.1.3",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.1",
    "@types/node": "^25.5.0",
    "astro": "^6.0.8",
    "mermaid": "^11.13.0",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.77.0"
  }
}
