---
import { siteConfig } from "../config/site";
import { withBasePath } from "../lib/site";

const basePath = import.meta.env.BASE_URL ?? "/";

const footerIcons = {
  GitHub: {
    viewBox: "0 0 24 24",
    paths: [
      "M12 2C6.48 2 2 6.58 2 12.22c0 4.5 2.87 8.32 6.84 9.66.5.1.68-.22.68-.48 0-.24-.01-1.03-.01-1.88-2.78.62-3.37-1.21-3.37-1.21-.46-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .08 1.53 1.05 1.53 1.05.9 1.56 2.35 1.11 2.92.85.09-.67.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.3.1-2.72 0 0 .84-.27 2.75 1.05A9.32 9.32 0 0 1 12 6.84c.85 0 1.7.12 2.5.36 1.9-1.32 2.74-1.05 2.74-1.05.56 1.42.21 2.46.1 2.72.64.72 1.03 1.64 1.03 2.76 0 3.93-2.34 4.8-4.57 5.05.36.32.68.95.68 1.92 0 1.38-.01 2.48-.01 2.82 0 .27.18.59.69.48A10.24 10.24 0 0 0 22 12.22C22 6.58 17.52 2 12 2Z",
    ],
  },
  RSS: {
    viewBox: "0 0 24 24",
    paths: [
      "M6.18 17.82a2.18 2.18 0 1 0 0 4.36 2.18 2.18 0 0 0 0-4.36Zm-3.09-8.55v3.27c4.98 0 9.37 4.39 9.37 9.46h3.27c0-6.89-5.66-12.73-12.64-12.73Zm0-6.55v3.27c8.58 0 15.55 7.06 15.55 15.73h3.27c0-10.49-8.49-19-18.82-19Z",
    ],
  },
  Email: {
    viewBox: "0 0 24 24",
    paths: [
      "M3 5.5A2.5 2.5 0 0 1 5.5 3h13A2.5 2.5 0 0 1 21 5.5v13a2.5 2.5 0 0 1-2.5 2.5h-13A2.5 2.5 0 0 1 3 18.5v-13Zm2.3.5 6.7 5.36L18.7 6H5.3Zm13.2 2.18-5.88 4.7a1 1 0 0 1-1.24 0L5.5 8.18V18.5c0 .28.22.5.5.5h12c.28 0 .5-.22.5-.5V8.18Z",
    ],
  },
} as const;
---

<footer class="site-footer">
  <div class="site-footer-inner">
    <div class="footer-copy">
      <strong>{siteConfig.title}</strong>
      <p>{siteConfig.description}</p>
    </div>

    <div class="footer-links">
      {siteConfig.socialLinks.map((item) => {
        const icon = footerIcons[item.label as keyof typeof footerIcons];

        return (
          <a
            class="footer-link-item"
            href={item.href.startsWith("/") ? withBasePath(item.href, basePath) : item.href}
          >
            {icon && (
              <span class="footer-link-icon" aria-hidden="true">
                <svg viewBox={icon.viewBox} fill="none">
                  {icon.paths.map((path) => (
                    <path d={path} fill="currentColor"></path>
                  ))}
                </svg>
              </span>
            )}
            <span>{item.label}</span>
          </a>
        );
      })}
    </div>
  </div>
</footer>
